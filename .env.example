# App/runtime
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Chateau Base

# API
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_CHATEAU_API_BASE_URL=http://127.0.0.1:4000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chateau_base

# Preserve-on-Base contract config.
# Leave blank in local dev when ChateauCellar is not deployed.
# Set only to real deployed, non-zero EVM contract addresses.
CHATEAU_CELLAR_BASE_ADDRESS=
CHATEAU_CELLAR_BASE_SEPOLIA_ADDRESS=

# Reserved for future Reown AppKit wiring.
NEXT_PUBLIC_REOWN_PROJECT_ID=
